{
  "description": "baton: inyecta el traspaso al arrancar (SessionStart), pide al resumidor el traspaso antes de compactar (PreCompact), captura el resumen de la compactacion (PostCompact), avisa al modelo cuando la ventana de contexto se llena (PostToolBatch) y pide el traspaso en el primer momento libre, tras compactar o al cruzar un umbral de la ventana (Stop). Ninguno bloquea nunca el arranque: todo camino sale con codigo 0.",
  "modules": ["./mod/register.tsx"],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact|resume|fork",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/baton_hook.py", "session-start"],
            "timeout": 10,
            "statusMessage": "baton: traspaso"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/baton_hook.py", "pre-compact"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/baton_hook.py", "post-compact"],
            "timeout": 10,
            "statusMessage": "baton: captura el resumen"
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/baton_hook.py", "tool-batch"],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/baton_hook.py", "stop"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
